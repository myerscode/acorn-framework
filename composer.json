{
    "name": "myerscode/acorn-framework",
    "description": "A framework for creating powerful PHP CLI applications",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Fred Myerscough",
            "email": "oniice@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.5",
        "league/container": "^5.0",
        "myerscode/config": "^2026",
        "myerscode/package-discovery": "^2026",
        "myerscode/utilities-bags": "^2026",
        "myerscode/utilities-files": "^2026",
        "myerscode/utilities-strings": "^2026",
        "nesbot/carbon": "^3.8.5",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0",
        "symfony/console": "^8.0",
        "symfony/event-dispatcher": "^8.0",
        "symfony/filesystem": "^8.0",
        "symfony/finder": "^8.0",
        "symfony/process": "^8.0",
        "symfony/yaml": "^8.1.10"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "mockery/mockery": "^1.4",
        "myerscode/acorn-testing": "dev-main",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "files": [
            "src/Foundation/Helpers.php"
        ],
        "psr-4": {
            "Myerscode\\Acorn\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "lint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
        "tests": "vendor/bin/phpunit --testdox --no-coverage --colors=always",
        "test-coverage": "vendor/bin/phpunit --testdox --colors=always",
        "security-audit": "@composer audit"
    }
}